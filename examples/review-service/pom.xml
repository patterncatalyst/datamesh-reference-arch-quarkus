<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patterncatalyst.datamesh</groupId>
    <artifactId>datamesh-examples-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>review-service</artifactId>
  <packaging>jar</packaging>

  <name>DataMesh :: Review Service</name>
  <description>
    review-service data product for the DataMesh reference architecture:
    product reviews/ratings, mirroring the Python capstone's review-service.
    Owns its own `reviews` table (per-service ownership). Exposes a Panache +
    RESTEasy Reactive REST data product: POST /reviews, GET /reviews,
    GET /reviews?sku=... All versions (Quarkus, JDK release) are inherited
    from the parent BOM import -- do not re-pin them here.
  </description>

  <dependencies>
    <!-- REST data product -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- Bean Validation (rating 1..5 -> 400 on violation) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>

    <!-- Persistence: Panache active record + Postgres -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <!-- Health probes -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- OIDC bearer-token auth for DELETE /reviews/{id} (live demo).
         No quarkus.oidc.* config needed: with no auth-server-url set, Quarkus
         Dev Services auto-provisions a Keycloak container in dev/test with
         the default "quarkus" realm, "quarkus-app" client, and builtin
         alice/alice (admin+user) and bob/bob (user) accounts. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @TestSecurity (ReviewDeleteResourceTest, the OIDC/@RolesAllowed RBAC
         regression coverage for DELETE /reviews/{id}, code finding H2): lets
         a test run as a given user/role set without needing a real OIDC
         token, while leaving the quarkus-oidc extension's own unauthenticated
         401 behavior intact for the no-token case. Plain
         quarkus-test-security is sufficient here (role-based @RolesAllowed
         checks only): quarkus-test-security-oidc is a separate artifact
         needed only when a test also wants to inject/mock JsonWebToken
         claims, which these tests don't. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Appendix "Running on OpenShift Local (CRC)": -Popenshift adds
       quarkus-openshift, which uploads target/quarkus-app to a binary S2I
       build on the cluster (openshift/build-images.sh passes the build
       flags). No local container engine is involved, and the default build
       is unchanged. -->
  <profiles>
    <profile>
      <id>openshift</id>
      <dependencies>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-openshift</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
