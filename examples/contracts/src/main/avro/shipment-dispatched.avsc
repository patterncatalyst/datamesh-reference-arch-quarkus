{
  "type": "record",
  "name": "ShipmentDispatched",
  "namespace": "capstone.shipping.v1",
  "doc": "Emitted by shipping-service after a shipment for an order is dispatched. Runtime contract for the shipment-dispatched Kafka topic.",
  "fields": [
    { "name": "event_type",       "type": "string", "doc": "Always 'shipment.dispatched'." },
    { "name": "order_id",         "type": "string", "doc": "Order aggregate id this shipment belongs to (also the Kafka message key)." },
    { "name": "customer_id",      "type": "string" },
    { "name": "item_sku",         "type": "string" },
    { "name": "quantity",         "type": "int" },
    { "name": "carrier",          "type": "string" },
    { "name": "tracking_number",  "type": "string" },
    { "name": "status",           "type": "string" },
    { "name": "created_at",       "type": "string", "doc": "ISO-8601 timestamp." }
  ]
}
