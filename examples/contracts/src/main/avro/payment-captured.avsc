{
  "type": "record",
  "name": "PaymentCaptured",
  "namespace": "capstone.payment.v1",
  "doc": "Emitted by payment-service after a payment for an order is captured. Runtime contract for the payment-captured Kafka topic.",
  "fields": [
    { "name": "event_type",  "type": "string", "doc": "Always 'payment.captured'." },
    { "name": "order_id",    "type": "string", "doc": "Order aggregate id this payment belongs to (also the Kafka message key)." },
    { "name": "customer_id", "type": "string" },
    { "name": "amount",      "type": "string", "doc": "Decimal serialized as string (mirrors OrderPlaced.amount; Avro decimal logical type is the refinement)." },
    { "name": "status",      "type": "string" },
    { "name": "created_at",  "type": "string", "doc": "ISO-8601 timestamp." }
  ]
}
