<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patterncatalyst.datamesh</groupId>
    <artifactId>datamesh-examples-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>inventory-service</artifactId>
  <packaging>jar</packaging>

  <name>DataMesh :: Inventory Service</name>
  <description>
    Inventory data product for the reference architecture. Owns the `stock`
    table (Panache) and serves the synchronous InventoryService/CheckStock
    gRPC call that order-service uses when placing an order, plus a small
    REST surface for seeding/inspecting stock during demos. gRPC server
    stubs are generated at build time from the `capstone.inventory.v1`
    proto packaged in the `contracts` dependency jar -- see
    quarkus.generate-code.grpc.scan-for-proto below and contracts/README.md.
  </description>

  <dependencies>
    <!-- Shared libs (versions come from the parent reactor; never re-pin). -->
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>domain-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- gRPC server -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>

    <!-- Persistence: Panache + Postgres (Dev Services auto-starts a
         container in dev/test mode; no datasource URL configured here). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <!-- REST -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- Health -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Version/executions (build, generate-code, generate-code-tests)
           are inherited from the parent's pluginManagement; only the
           module opt-in is needed here. -->
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <!-- Parent pom's pluginManagement pins the failsafe version + UTC
           system property reactor-wide but does NOT bind any executions
           (only surefire's default test-compile/test lifecycle binding and
           the quarkus-maven-plugin's build/generate-code executions are
           bound there). Without this execution, *IT classes (e.g.
           InventoryCheckStockWireIT) are compiled by test-compile but
           failsafe never runs them under `mvn verify`. Bind
           integration-test+verify explicitly here, mirroring
           order-service/pom.xml's identical binding. No Avro
           SERIALIZABLE_PACKAGES system property is needed here, unlike
           order-service's binding: inventory-service's IT drives a plain
           io.grpc ManagedChannel/blocking stub against the packaged
           service's gRPC port, not a raw Avro-encoded Kafka record. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- InventoryCheckStockWireIT is a @QuarkusIntegrationTest: it
                 launches the packaged quarkus-run.jar as a SEPARATE process,
                 which does NOT inherit this test JVM's user.timezone=UTC
                 (set in the parent pom's surefire/failsafe config). Without
                 UTC, the PostgreSQL JDBC driver forwards the host's legacy
                 Olson zone (e.g. US/Eastern) as the connection TimeZone,
                 which postgres:18 rejects ("FATAL: invalid value for
                 parameter TimeZone"), so Hibernate can't connect and the app
                 fails to start. quarkus.test.arg-line forwards the
                 JVM arg to the launched integration-test process. -->
            <quarkus.test.arg-line>-Duser.timezone=UTC</quarkus.test.arg-line>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
