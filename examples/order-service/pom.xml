<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patterncatalyst.datamesh</groupId>
    <artifactId>datamesh-examples-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>order-service</artifactId>
  <packaging>jar</packaging>

  <name>DataMesh :: Order Service</name>
  <description>
    Order data product (r21/r23/r25 in the Python reference architecture):
    Panache-owned Order entity, REST endpoints, a gRPC CheckStock call to
    inventory-service before persisting, and an order.placed Avro event
    published via Apicurio Schema Registry after the order is
    durably persisted.
  </description>

  <dependencies>
    <!-- Shared contracts: domain DTOs/enums/Topics and the Avro OrderPlaced
         record + inventory.proto (scanned via quarkus.generate-code.grpc.scan-for-proto
         below). Versions are NOT re-pinned here; they are inherited
         transitively as plain jar coordinates, not through a BOM import. -->
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>domain-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- REST -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- Bean Validation (OrderCreate -> 400 on violation, parity with
         review-service's quarkus-hibernate-validator usage). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>

    <!-- Persistence: Panache-owned Order entity + Postgres (Dev Services in dev/test) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <!-- gRPC client to inventory-service (stub generated from the contracts
         jar's packaged .proto; see quarkus.generate-code.grpc.scan-for-proto
         in application.properties). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>

    <!-- Kafka producer: order.placed emitted as Avro via Apicurio. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-apicurio-registry-avro</artifactId>
    </dependency>

    <!-- Ops -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Byte-level proof that order.placed is Avro on the
         wire. OrderPlacedAvroWireIT self-provisions a Kafka + Apicurio
         Testcontainers pair (pinned to the same tags as infra/README.md's
         compose stack) rather than reusing Quarkus Dev Services, so
         it can drive a raw KafkaProducer/KafkaConsumer independent of the
         application's own Reactive Messaging wiring.

         NOTE on artifact ids: the quarkus-bom:3.39.5-managed Testcontainers
         release is 2.0.5, which renamed the modules with a
         "testcontainers-" prefix (org.testcontainers:testcontainers-kafka,
         org.testcontainers:testcontainers-junit-jupiter), confirmed by
         grepping quarkus-bom-3.39.5.pom; the older org.testcontainers:kafka
         / org.testcontainers:junit-jupiter coordinates are NOT present in
         that BOM. Using the BOM-managed artifact ids here (no explicit
         <version>) keeps this module on the same Testcontainers train as
         every other Quarkus Dev-Services-backed test in the reactor. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <!-- Parent pom's pluginManagement pins the failsafe version + UTC
           system property reactor-wide but does NOT bind any executions
           (only surefire's default test-compile/test lifecycle binding and
           the quarkus-maven-plugin's build/generate-code executions are
           bound there). Without this execution, *IT classes are compiled
           by test-compile but failsafe never runs them under `mvn verify`.
           Bind integration-test+verify explicitly here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Avro 1.12.x's ClassSecurityValidator (CVE-driven hardening
                 against untrusted-class deserialization) refuses to build a
                 SpecificDatumWriter for any generated record class whose
                 package isn't explicitly trusted, UNLESS a Quarkus
                 application is running (the quarkus-avro extension trusts
                 the app's own generated packages at build/runtime
                 automatically). OrderPlacedAvroWireIT is a plain JUnit test
                 (no @QuarkusTest, no Quarkus runtime bootstrap) driving a
                 raw KafkaProducer, so it hit
                 "SecurityException: Forbidden capstone.order.v1.OrderPlaced!"
                 without this, confirmed by actually running the IT.
                 Trusting the contracts module's Avro package here is scoped
                 to this module's test JVM only. -->
            <org.apache.avro.SERIALIZABLE_PACKAGES>capstone.order.v1</org.apache.avro.SERIALIZABLE_PACKAGES>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Appendix "Running on OpenShift Local (CRC)": -Popenshift adds
       quarkus-openshift, which uploads target/quarkus-app to a binary S2I
       build on the cluster (openshift/build-images.sh passes the build
       flags). No local container engine is involved, and the default build
       is unchanged. -->
  <profiles>
    <profile>
      <id>openshift</id>
      <dependencies>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-openshift</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
