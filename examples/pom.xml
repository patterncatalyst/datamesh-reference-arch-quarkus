<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.datamesh</groupId>
  <artifactId>datamesh-examples-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>DataMesh Reference Architecture (Quarkus) :: Examples</name>
  <description>
    Maven reactor for the runnable examples backing the Quarkus DataMesh reference
    architecture tutorial (shipping/order domain). See the version matrix and
    settled architecture decisions documented in the repo root.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- JDK 25, Quarkus 3.40.1 (LTS), Maven 3.9.x -->
    <maven.compiler.release>25</maven.compiler.release>

    <quarkus.platform.group-id>io.quarkus</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1</quarkus.platform.version>

    <quarkus-camel-bom.group-id>io.quarkus.platform</quarkus-camel-bom.group-id>
    <quarkus-camel-bom.version>3.40.1</quarkus-camel-bom.version>

    <quarkus-langchain4j-bom.group-id>io.quarkus.platform</quarkus-langchain4j-bom.group-id>
    <!-- The platform's own quarkus-langchain4j-bom (DRQ-029), at the platform
         version: it pins quarkus-langchain4j 1.13.3 and dev.langchain4j 1.19.3,
         the train camel-quarkus 3.40.0 is built and tested against. The earlier
         Quarkiverse 1.7.4 override (the 42-ai-mcp seed's version) no longer
         builds: camel-quarkus 3.40.0's langchain4j deployment needs
         ExcludeFromImpliedAiServiceBuildItem, which 1.7.4 does not ship.
         NOTE: version is NOT the cause of the Ollama tool-calling failure
         (DEF-001). camel-quarkus-support-langchain4j forces the JAX-RS HTTP
         client factory globally, and the agent's tool-call round trip never
         fires. The behavioural IT is opt-in and deferred; see the
         ai-mcp-service AgentProducers javadoc. -->
    <quarkus-langchain4j-bom.version>${quarkus.platform.version}</quarkus-langchain4j-bom.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <surefire-plugin.version>3.6.0</surefire-plugin.version>
  </properties>

  <!-- All 11 modules below are implemented; this is a full reactor build. -->
  <modules>
    <module>domain-model</module>
    <module>contracts</module>
    <module>order-service</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>shipping-service</module>
    <module>notification-service</module>
    <module>review-service</module>
    <module>graphql-gateway</module>
    <module>ai-mcp-service</module>
    <module>ai-rules-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- BOM import order: quarkus-langchain4j-bom first, then quarkus-bom,
           then quarkus-camel-bom. All three are the same platform release
           (DRQ-029), so they agree on the langchain4j surface
           (quarkus-langchain4j 1.13.3, dev.langchain4j 1.19.3) and the order no
           longer decides any version. Child modules must never re-declare or
           re-pin these imports. The order does NOT make Ollama tool-calling
           fire; that is the separate upstream issue documented above. -->
      <dependency>
        <groupId>${quarkus-langchain4j-bom.group-id}</groupId>
        <artifactId>quarkus-langchain4j-bom</artifactId>
        <version>${quarkus-langchain4j-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${quarkus-camel-bom.group-id}</groupId>
        <artifactId>quarkus-camel-bom</artifactId>
        <version>${quarkus-camel-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <!-- Force UTC for the test JVM. The postgres:18 Dev Services
                   container rejects legacy Olson zone ids (e.g. US/Eastern)
                   that pgjdbc forwards from the host default, failing boot
                   with: invalid value for parameter "TimeZone". Pinning UTC
                   here keeps the documented `mvn verify` working on any host. -->
              <user.timezone>UTC</user.timezone>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <user.timezone>UTC</user.timezone>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>${quarkus.platform.group-id}</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
          <extensions>true</extensions>
          <executions>
            <execution>
              <goals>
                <goal>build</goal>
                <goal>generate-code</goal>
                <goal>generate-code-tests</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Native image profile stub. Individual Quarkus application modules
         activate this with -Pnative; domain-model/contracts are plain jars
         and never build native. -->
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
      </properties>
    </profile>
  </profiles>
</project>
