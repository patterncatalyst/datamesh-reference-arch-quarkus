<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- This module is DELIBERATELY NOT part of the examples/ Maven reactor
       (it is not listed in examples/pom.xml's <modules>, by design - see
       DRQ-006). It is a standalone Spring Boot project with its own parent
       (spring-boot-starter-parent), built independently so chapter 12's
       startup/memory/native comparison numbers reflect an unmodified,
       idiomatic Spring Boot build - not one bent to fit the Quarkus
       reactor's BOM/plugin wiring. It still reuses domain-model and
       contracts as plain jar dependencies (installed to the local repo
       first - see README.md). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.patterncatalyst.datamesh</groupId>
  <artifactId>spring-boot-compare</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>DataMesh :: Spring Boot Compare (Order Service Twin)</name>
  <description>
    Faithful-but-minimal Spring Boot twin of the Quarkus order-service
    (DRQ-006), for a real side-by-side startup/memory comparison in
    tutorial chapter 12: same REST shapes/statuses (201/409/404/200), same
    Postgres-backed order entity, the same order.placed Avro event over
    Kafka/Apicurio, and the same synchronous gRPC CheckStock call to
    inventory-service before persisting. Not part of the examples/ reactor
    on purpose -- built standalone against domain-model/contracts jars.
  </description>

  <properties>
    <java.version>25</java.version>
    <datamesh.domain-contracts.version>1.0.0-SNAPSHOT</datamesh.domain-contracts.version>

    <!-- grpc-protobuf 1.73.0 depends on protobuf-java 3.25.5 (confirmed via
         its published POM); protoc is pinned to the SAME version so the
         compiler generating the Java sources matches the protobuf-java
         runtime this module actually ships - mirrors the lockstep the
         contracts module keeps between its avro runtime and avro-maven-plugin. -->
    <grpc.version>1.73.0</grpc.version>
    <protobuf.version>3.25.5</protobuf.version>
    <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>

    <!-- Not managed by spring-boot-dependencies; latest stable on Maven
         Central at the time of writing. -->
    <apicurio-registry-serdes-avro-serde.version>2.6.9.Final</apicurio-registry-serdes-avro-serde.version>
  </properties>

  <dependencies>
    <!-- Shared contracts: framework-agnostic DTOs/enums/Topics (domain-model)
         and the generated Avro OrderPlaced SpecificRecord (contracts). Both
         are plain jar dependencies, NOT reactor modules - install them to
         the local repo first (see README.md). No source is copied from
         either. -->
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>domain-model</artifactId>
      <version>${datamesh.domain-contracts.version}</version>
    </dependency>
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>contracts</artifactId>
      <version>${datamesh.domain-contracts.version}</version>
    </dependency>

    <!-- REST -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation (OrderCreate -> 400 on violation, parity with the
         Quarkus order-service's quarkus-hibernate-validator usage). NOT
         pulled in transitively by spring-boot-starter-web; Boot ships
         the Hibernate Validator implementation only via this dedicated
         starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence: JPA-owned OrderEntity + Postgres (Quarkus twin uses
         Panache; Spring has no equivalent active-record layer in scope, so
         this is plain Spring Data JPA). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Ops: /actuator/health, matching quarkus-smallrye-health's /q/health. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Kafka producer: order.placed emitted as Avro via Apicurio (DRQ-009),
         mirroring quarkus-messaging-kafka + quarkus-apicurio-registry-avro.
         Spring Boot 4.0 extracted Kafka auto-configuration into the dedicated
         spring-boot-kafka module; spring-kafka core alone does NOT bring it, so
         spring.kafka.* would be inert and no ProducerFactory/KafkaTemplate
         beans would be created (context fails to start). Pull both. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>io.apicurio</groupId>
      <artifactId>apicurio-registry-serdes-avro-serde</artifactId>
      <version>${apicurio-registry-serdes-avro-serde.version}</version>
    </dependency>

    <!-- gRPC client to inventory-service: raw grpc-java (not the still-0.x
         spring-grpc starter - see README.md for why), stubs generated by
         protobuf-maven-plugin below from the SAME .proto the Quarkus
         order-service scans out of the contracts jar
         (capstone/inventory/v1/inventory.proto), read directly from the
         sibling contracts module's source tree rather than duplicated here. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!-- protoc-gen-grpc-java's generated stubs reference javax.annotation.Generated
         (the annotation moved out of java.base on JDK 9+, and grpc-java's
         codegen still targets the javax, not jakarta, package). -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 split @AutoConfigureMockMvc / @WebMvcTest support out
         of spring-boot-test-autoconfigure into this dedicated module
         (confirmed by inspecting the published jars: the "test slice"
         modules are now one-per-web-stack, mirroring the main
         spring-boot-webmvc / spring-boot-webflux split). NOT pulled in
         transitively by spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- Resolves the ${os.detected.classifier} property protoc/protoc-gen-grpc-java
           binaries are published under (e.g. linux-x86_64). -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Same DRQ-011 crux as the Quarkus reactor's root pom: the
           postgres:18 Testcontainers image rejects legacy Olson zone ids
           (e.g. US/Eastern) that pgjdbc forwards from the host's default
           JVM timezone at connection startup, failing with
           "FATAL: invalid value for parameter TimeZone", confirmed by
           actually running this module's tests. This module is NOT part
           of the examples/ reactor, so it does not inherit that root pom's
           pluginManagement; pin UTC here explicitly so `mvn package` is
           reproducible on any host. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <user.timezone>UTC</user.timezone>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>${protobuf-maven-plugin.version}</version>
        <configuration>
          <!-- Read the single source of truth for the inventory contract
               straight from the sibling contracts module's source tree
               instead of copying the .proto into this module. Mirrors the
               Quarkus side's quarkus.generate-code.grpc.scan-for-proto,
               which scans the SAME file out of the contracts dependency
               jar; this module just points protoc at the file on disk
               since protobuf-maven-plugin has no jar-scanning equivalent. -->
          <protoSourceRoot>${project.basedir}/../contracts/src/main/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
