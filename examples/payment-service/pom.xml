<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patterncatalyst.datamesh</groupId>
    <artifactId>datamesh-examples-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>payment-service</artifactId>
  <packaging>jar</packaging>

  <name>DataMesh :: Payment Service</name>
  <description>
    Real event-driven choreography processor: consumes
    OrderPlaced (capstone.order.v1) Avro events from the order.placed Kafka
    topic and emits PaymentCaptured (capstone.payment.v1) Avro events to the
    payment.captured Kafka topic. Both channels are Avro-serialized against
    the Apicurio Schema Registry via quarkus-apicurio-registry-avro; Kafka
    and Apicurio Registry are provided by Quarkus Dev Services in dev/test
    mode. See README.md for the wiring details.
  </description>

  <dependencies>
    <!-- Shared, framework-agnostic modules -->
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>domain-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.patterncatalyst.datamesh</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Reactive Messaging + Kafka -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>

    <!-- Avro serde against the Apicurio Schema Registry -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-apicurio-registry-avro</artifactId>
    </dependency>

    <!-- Health checks -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Appendix "Running on OpenShift Local (CRC)": -Popenshift adds
       quarkus-openshift, which uploads target/quarkus-app to a binary S2I
       build on the cluster (openshift/build-images.sh passes the build
       flags). No local container engine is involved, and the default build
       is unchanged. -->
  <profiles>
    <profile>
      <id>openshift</id>
      <dependencies>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-openshift</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
