# Containerfile.multistage — graphql-gateway
#
# Build (context = repo root, run from the repo root directory):
#   docker build -f examples/graphql-gateway/src/main/docker/Containerfile.multistage -t datamesh/graphql-gateway .
#
# Build context is the REPO ROOT, not examples/ — this lets the builder stage
# COPY the whole `examples/` Maven reactor (graphql-gateway's sibling modules
# domain-model and contracts, both required at compile time: domain-model for
# the OrderDto shape federated from order-service's REST API, contracts for
# the inventory.proto scanned via quarkus.generate-code.grpc.scan-for-proto)
# in one shot. docker compose / K8s manifests that build this image must set
# the same context (repo root) and this exact -f path.
#
# Two stages:
#   1. `build`   — registry.access.redhat.com/ubi10/openjdk-25 (JDK 25 + Maven
#                  preinstalled). Builds the reactor with `mvn -pl
#                  graphql-gateway -am package` so domain-model + contracts
#                  resolve as reactor deps, and the gRPC stub codegen in
#                  contracts runs before graphql-gateway compiles against it.
#   2. `runtime` — registry.access.redhat.com/ubi10/openjdk-25-runtime. Copies
#                  ONLY graphql-gateway's target/quarkus-app/ fast-jar output
#                  (lib/, quarkus-run.jar, app/, quarkus/) — never the whole
#                  reactor, never the builder's Maven cache.
#
# graphql-gateway federates order-service (REST, ORDER_SERVICE_URL) and
# inventory-service (gRPC CLIENT, INVENTORY_GRPC_HOST/INVENTORY_GRPC_PORT —
# see src/main/resources/application.properties) behind /graphql. It owns no
# gRPC server of its own, so only the HTTP port is exposed here; the
# inventory-service gRPC endpoint it calls out to is reached over the compose/
# K8s network via env vars, not published on this image.

# ─── Stage 1: build (reactor-aware) ──────────────────────────────────────
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-15 AS build

WORKDIR /build

# Copy the whole examples/ reactor (root pom + every module). A single COPY is
# used rather than per-module layering because domain-model/contracts changes
# should invalidate this service's build layer anyway (they're compile-time
# reactor deps), so there's no cache-hit to preserve by splitting it further.
COPY --chown=185 examples/ ./examples/

WORKDIR /build/examples

# -pl graphql-gateway -am: build this module PLUS its required upstream
# reactor modules (domain-model, contracts) — NOT the full reactor — so gRPC
# stub codegen in contracts runs before graphql-gateway compiles against the
# generated classes.
RUN mvn -q -pl graphql-gateway -am package -DskipTests

# ─── Stage 2: runtime ────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-15 AS runtime

# Quarkus's fast-jar layout separates the app into layers (lib/, quarkus/,
# app/) that map naturally onto container image layers — dependencies rarely
# change, application classes change often. Preserve that structure rather
# than flattening into a single fat jar copy.
WORKDIR /deployments
COPY --from=build --chown=185 /build/examples/graphql-gateway/target/quarkus-app/lib/ ./lib/
COPY --from=build --chown=185 /build/examples/graphql-gateway/target/quarkus-app/*.jar ./
COPY --from=build --chown=185 /build/examples/graphql-gateway/target/quarkus-app/app/ ./app/
COPY --from=build --chown=185 /build/examples/graphql-gateway/target/quarkus-app/quarkus/ ./quarkus/

EXPOSE 8080

# Pin UTC (Postgres Dev Services / real Postgres rejects legacy
# Olson zone ids forwarded from the host default) + run with the %prod
# profile so compose/K8s deployments use the same env-driven config
# (KAFKA_BOOTSTRAP_SERVERS / APICURIO_REGISTRY_URL / JDBC_URL / INVENTORY_GRPC_*)
# as the rest of the project.
ENV JAVA_OPTS_APPEND="-Duser.timezone=UTC -Dquarkus.profile=prod"

# UBI OpenJDK runtime images already default to UID 185 (non-root); explicit
# here for clarity and to guard against a base-image change silently
# reverting to root.
USER 185

ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
