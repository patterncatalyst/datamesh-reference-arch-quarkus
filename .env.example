# .env.example — template for the standalone docker compose stack.
#
# Copy this to `.env` (which is gitignored) before `docker compose up -d`:
#
#     cp .env.example .env
#
# The values below are safe local-dev defaults for EPHEMERAL containers
# (throwaway credentials, host ports). Never reuse the Postgres credentials
# outside local development.
#
# CRITICAL (wire-compat crux): POSTGRES_IMAGE, KAFKA_IMAGE, and
# APICURIO_IMAGE MUST equal the exact tags Quarkus 3.39.5 Dev Services
# pulls by default, so behavior does not drift between `quarkus:dev`/`mvn
# verify` (Dev Services / Testcontainers) and this standalone compose
# stack. Confirmed by inspecting the build-time config classes inside the
# cached Quarkus 3.39.5 deployment jars in ~/.m2 (see infra/README.md for
# the exact commands and evidence). Do not bump these without re-verifying
# against the Quarkus version in CLAUDE.md's version matrix.

# ── Image tags ─────────────────────────────────────────────────────────
POSTGRES_IMAGE=docker.io/library/postgres:18
KAFKA_IMAGE=docker.io/apache/kafka-native:4.2.0
APICURIO_IMAGE=quay.io/apicurio/apicurio-registry:3.1.7
LGTM_IMAGE=docker.io/grafana/otel-lgtm:0.8.1
KAFKA_UI_IMAGE=docker.io/provectuslabs/kafka-ui:latest
OLLAMA_IMAGE=docker.io/ollama/ollama:latest

# ── Ports (host-side; container-internal ports are fixed in compose.yaml) ─
POSTGRES_PORT=5432
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=9094
APICURIO_PORT=8081
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MIMIR_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
KAFKA_UI_PORT=8090
OLLAMA_PORT=11434

# ── Postgres bootstrap credentials (dev-only; change for any shared use) ──
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=appdb

# ── Kafka cluster identity (KRaft) ────────────────────────────────────────
# Any valid base64-like 22-char string works; changing it after the
# kafka-data volume has state requires `docker compose down -v` (see
# lgtm-docker-stack references/known-issues.md, "Kafka KRaft cluster ID").
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
