		{
			"name": "GraphQL",
			"item": [
				{
					"name": "POST /graphql order+stock federation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{gatewayBase}}/graphql",
							"host": [
								"{{gatewayBase}}"
							],
							"path": [
								"graphql"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\"query\": \"{ order(id:\\\"{{orderId}}\\\") { orderId itemSku quantity stock { sku available quantityOnHand } } }\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('no graphql errors', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.errors).to.be.undefined;",
									"});",
									"",
									"pm.test('order.orderId matches', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.data.order.orderId).to.eql(pm.environment.get('orderId'));",
									"});",
									"",
									"pm.test('order.stock is present with boolean available', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.data.order.stock).to.not.be.null;",
									"    pm.expect(typeof json.data.order.stock.available).to.eql('boolean');",
									"});",
									"",
									"pm.test('order.stock.sku matches order.itemSku', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.data.order.stock.sku).to.eql(json.data.order.itemSku);",
									"});"
								]
							}
						}
					]
				}
			]
		},
